# ── Servis adresleri (port bu URL'den türetilir) ──
GATEWAY_REST_URL=http://127.0.0.1:2000
SERVICE_IDENTITY_REST_URL=http://127.0.0.1:2001
SERVICE_CONTENT_REST_URL=http://127.0.0.1:2002
SERVICE_LEARNING_REST_URL=http://127.0.0.1:2003
SERVICE_BILLING_REST_URL=http://127.0.0.1:2004
SERVICE_TUTOR_REST_URL=http://127.0.0.1:2005

# ── Veri kaynakları (docker-compose.dev.yml) ──
CORE_APP_DB_CONNECTION_STRING=postgres://sinav_dev:dev_pass@127.0.0.1:5434/sinav
CORE_REDIS_URL=redis://127.0.0.1:6380/1
CORE_REDIS_PASSWORD=
CORE_DISCOVERY_REDIS_URL=redis://127.0.0.1:6380/0
CORE_DISCOVERY_REDIS_PASSWORD=

# ── Gateway ──
PROJECT_PREFIX=service
PUBSUB_CHANNEL=app.fct.servicerestarted
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LANDING_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
PUBLIC_APP_BASE_URL=http://127.0.0.1:3000
ALLOW_INSECURE_COOKIES=true
LISTEN_HOST=

# ── Oturum: tamsayı SANİYE (sonek YASAK) ──
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=1209600
MOBILE_REFRESH_TOKEN_EXPIRY=5184000

# ── SIRLAR: openssl rand -hex 32 ──
INTERNAL_API_KEY=
COOKIE_SECRET=
OPENAPI_UI_KEY=
OTP_PEPPER=
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem

# ── Rate limit (boş = koddaki varsayılan) ──
# RATE_LIMIT_MAX=
# RATE_LIMIT_SESSION_MAX=
# RATE_LIMIT_AUTH_MAX=
# DISABLE_CRON=true

# ── E-posta (tetikleyici SMTP_HOST) ──
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=ODAK <no-reply@sinav.local>
SUPPORT_EMAIL=destek@sinav.local

# ── Ödeme: fake yalnızca dev'de (üretimde açılışı düşürür) ──
PAYMENT_PROVIDER=fake
PAYMENT_FAKE_SECRET=

# ── Yapay zekâ (OpenRouter). Anahtar boşsa tutor "not_configured" ──
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TUTOR_MODEL=anthropic/claude-haiku-5.5
CONTENT_MODEL=openrouter/auto
EVAL_MODEL=anthropic/claude-haiku-5.5
# openrouter/auto yalnız bu modeller arasından seçer (virgüllü; joker: deepseek/*). Boşsa sınırsız.
OPENROUTER_AUTO_ALLOWED=
# İstek başına fiyat tavanı ($/milyon token): prompt,completion
OPENROUTER_MAX_PRICE=
OPENROUTER_AUTO_COST_TIER=low
# Düşünme payı (low|medium|high); boşsa modelin varsayılanı.
OPENROUTER_REASONING_EFFORT=low
# Aynı modeli satan sağlayıcılar arasında seçim: price (en ucuz) | throughput | latency. Boş: OpenRouter varsayılanı.
OPENROUTER_PROVIDER_SORT=

# ÖSYM takvim taraması: duyuru aranacak ana sayfa (varsayılan https://www.osym.gov.tr/).
# OSYM_HOME_URL=https://www.osym.gov.tr/
