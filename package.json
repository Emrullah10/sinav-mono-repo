{
  "name": "sinav-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/modules/*",
    "packages/persistence-utils",
    "packages/query-builder",
    "packages/design-tokens",
    "packages/client-sdk",
    "packages/i18n",
    "core/*",
    "services/*"
  ],
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:fresh": "node scripts/db-fresh.mjs",
    "dev:backend": "bash scripts/start-backend.sh",
    "dev:local": "cd sinav-web-app && VITE_PROXY_TARGET=http://127.0.0.1:2000 vite",
    "dev": "npm run dev:local",
    "dev:landing": "cd sinav-landing-app && astro dev --port 4321",
    "build": "cd sinav-web-app && vite build",
    "build:landing": "cd sinav-landing-app && astro build",
    "tokens:build": "node packages/design-tokens/build.mjs",
    "build-schema": "node scripts/build-schema.js",
    "migrate:status": "node scripts/apply-migrations.mjs --status",
    "migrate": "node scripts/apply-migrations.mjs --pending",
    "seed": "node scripts/seed/index.mjs",
    "build-role-permission-seed": "node scripts/build-role-permission-seed.js --write",
    "validate-auth-config": "node scripts/validate-auth-config.js",
    "sync-role-permissions": "node scripts/sync-role-permissions.mjs",
    "gen-table-definitions": "node scripts/gen-table-definitions.mjs",
    "check:contract": "node scripts/check-client-sdk.mjs",
    "sync:mobile": "node scripts/sync-mobile.mjs --target ../sinav-mobile",
    "update": "bash scripts/update.sh",
    "lint": "eslint .; b=$?; (cd sinav-web-app && eslint .); w=$?; exit $(( b > w ? b : w ))",
    "format": "prettier --write \"./**/*.{js,jsx,json,css,scss,md}\""
  },
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "12factor-config": "^2.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "ts-fsrs": "^5.4.2",
    "uuid": "^13.0.2"
  }
}
