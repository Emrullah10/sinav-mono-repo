{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@assets/*": ["src/assets/*"], "@components/*": ["src/components/*"], "@container/*": ["src/container/*"],
      "@hooks/*": ["src/hooks/*"], "@layouts/*": ["src/layouts/*"], "@pages/*": ["src/pages/*"], "@router/*": ["src/router/*"],
      "@shared/*": ["src/shared/*"], "@store": ["src/store/index.jsx"], "@store/*": ["src/store/*"], "@styles/*": ["src/styles/*"],
      "@api": ["src/api/index.jsx"], "@api/*": ["src/api/*"], "@features/*": ["src/features/*"]
    }
  },
  "include": ["src"]
}
