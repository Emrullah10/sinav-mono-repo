---
const { source = 'landing', examKey = 'yds-en' } = Astro.props;
---
<form class="odak-form space-y-3" data-kind="waitlist" data-source={source} data-exam={examKey} novalidate>
  <label class="block text-sm font-medium" for={`wl-${source}`}>E-posta</label>
  <input id={`wl-${source}`} name="email" type="email" required autocomplete="email" placeholder="ornek@eposta.com" class="w-full rounded-lg border border-line bg-surface px-3 py-2" />
  <label class="flex items-start gap-2 text-sm text-ink-2"><input type="checkbox" name="marketingConsent" class="mt-1" /> Sınav takvimi ve kampanyalar hakkında e-posta almak istiyorum.</label>
  <button type="submit" class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white">Listeye katıl</button>
  <p class="form-msg text-sm" role="status" aria-live="polite"></p>
</form>
