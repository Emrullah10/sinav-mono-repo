---
---
<form class="odak-form space-y-3" data-kind="contact" novalidate>
  <div class="grid gap-3 sm:grid-cols-2">
    <div><label class="block text-sm font-medium" for="c-name">Ad</label><input id="c-name" name="name" autocomplete="name" class="w-full rounded-lg border border-line bg-surface px-3 py-2" /></div>
    <div><label class="block text-sm font-medium" for="c-email">E-posta</label><input id="c-email" name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-line bg-surface px-3 py-2" /></div>
  </div>
  <div><label class="block text-sm font-medium" for="c-topic">Konu</label>
    <select id="c-topic" name="topic" class="w-full rounded-lg border border-line bg-surface px-3 py-2">
      <option value="account">Hesap</option><option value="payment">Ödeme</option><option value="plan">Plan</option><option value="exam_info">Sınav bilgisi</option><option value="content_error">İçerik hatası</option><option value="other" selected>Diğer</option>
    </select></div>
  <div><label class="block text-sm font-medium" for="c-subject">Başlık</label><input id="c-subject" name="subject" maxlength="150" class="w-full rounded-lg border border-line bg-surface px-3 py-2" /></div>
  <div><label class="block text-sm font-medium" for="c-body">Mesajın</label><textarea id="c-body" name="body" required minlength="5" maxlength="5000" rows="6" class="w-full rounded-lg border border-line bg-surface px-3 py-2"></textarea></div>
  <button type="submit" class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white">Gönder</button>
  <p class="form-msg text-sm" role="status" aria-live="polite"></p>
</form>
