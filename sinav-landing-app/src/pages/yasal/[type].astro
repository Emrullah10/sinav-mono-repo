---
import Base from '../../layouts/Base.astro';
import { getLegalList, getLegal } from '../../lib/data.mjs';
import { md, fmtDate } from '../../lib/md.mjs';
export async function getStaticPaths() {
  const list = await getLegalList();
  return Promise.all(list.map(async (d) => ({ params: { type: d.type }, props: { doc: await getLegal(d.type) } })));
}
const { doc } = Astro.props;
const html = await md(doc.bodyMd);
---
<Base title={doc.title}>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <p class="text-sm"><a href="/yasal">← Yasal belgeler</a></p>
    <h1 class="mt-3 font-display text-4xl font-bold">{doc.title}</h1>
    <p class="mt-2 text-sm text-ink-2">Sürüm {doc.version} · {fmtDate(doc.publishedAt)}</p>
    <div class="prose-odak mt-8" set:html={html} />
  </article>
</Base>
