---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import FormScript from '../components/FormScript.astro';
---
<Base title="İletişim" description="Soru, öneri ve içerik hatası bildirimi için bize yaz.">
  <section class="mx-auto max-w-2xl px-4 py-14">
    <h1 class="font-display text-4xl font-bold">İletişim</h1>
    <p class="mt-3 text-ink-2">Önce <a href="/sss">sık sorulan sorulara</a> göz atabilirsin. Mesajına e-postayla dönüş yaparız.</p>
    <div class="mt-8 rounded-2xl border border-line bg-surface p-6"><ContactForm /></div>
  </section>
  <FormScript />
</Base>
