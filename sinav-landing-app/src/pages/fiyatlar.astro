---
import Base from '../layouts/Base.astro';
import { APP_URL } from '../lib/public-api.mjs';
import { getProducts, getArticles } from '../lib/data.mjs';
import { tl } from '../lib/md.mjs';

const products = await getProducts();
const faq = (await getArticles('help')).filter((a) => ['odeme', 'plan'].includes(a.category?.key)).slice(0, 6);
const LABEL = {
  questions_per_day: 'Günlük soru', tutor_messages_per_day: 'Öğretmen mesajı (günlük)', flashcard_reviews_per_day: 'Kart tekrarı (günlük)',
  translation_evals_per_day: 'Çeviri değerlendirmesi (günlük)', mini_exams_per_month: 'Mini deneme (aylık)', full_exams_per_month: 'Tam deneme (aylık)',
  detailed_analysis: 'Ayrıntılı analiz', score_estimate: 'Puan tahmini',
};
const feats = Object.keys(LABEL);
const cell = (p, key) => { const f = p.features.find((x) => x.feature === key); if (!f || !f.enabled) return '—'; return f.limit == null ? 'Sınırsız' : String(f.limit); };
const interval = { none: '', month: '/ ay', year: '/ yıl', once: 'tek seferlik' };
---
<Base title="Fiyatlar" description="Ücretsiz başla; Premium ile sınırsız soru, deneme ve ayrıntılı analiz.">
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-center font-display text-4xl font-bold">Şeffaf, taahhütsüz fiyatlar</h1>
    <p class="mx-auto mt-3 max-w-2xl text-center text-ink-2">İstediğin zaman iptal et. Deneme süresinde ücret alınmaz.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {products.map((p) => { const pr = p.prices[0]; return (
        <article class={`flex flex-col rounded-2xl border bg-surface p-6 ${p.recommended ? 'border-brand ring-2 ring-brand' : 'border-line'}`}>
          {p.recommended && <span class="mb-2 w-fit rounded-full bg-brand-soft px-3 py-1 text-xs font-semibold text-brand">En çok tercih edilen</span>}
          <h2 class="text-xl font-semibold">{p.name}</h2>
          <p class="mt-1 text-sm text-ink-2">{p.description}</p>
          <p class="mt-5 font-display text-4xl font-bold">{pr.amount === 0 ? '0 TL' : tl(pr.amount)} <span class="text-base font-normal text-ink-2">{interval[pr.interval] ?? ''}</span></p>
          {pr.monthlyEquivalent > 0 && pr.interval !== 'month' && <p class="text-sm text-ink-2">aylık ≈ {tl(pr.monthlyEquivalent)}</p>}
          {p.trialDays > 0 && <p class="mt-2 text-sm font-medium text-success">{p.trialDays} gün ücretsiz deneme</p>}
          <ul class="mt-4 flex-1 space-y-1 text-sm">{feats.filter((k) => cell(p, k) !== '—').slice(0, 6).map((k) => <li>✓ {LABEL[k]}: <b>{cell(p, k) === 'Sınırsız' ? 'Sınırsız' : cell(p, k) === '' ? '' : cell(p, k)}</b></li>)}</ul>
          <a href={`${APP_URL}/baslangic?plan=${p.productKey}`} class={`mt-6 rounded-lg px-4 py-2.5 text-center font-semibold no-underline ${p.recommended ? 'bg-brand text-white' : 'border border-line text-ink'}`}>{p.tier === 'free' ? 'Ücretsiz başla' : p.trialDays > 0 ? `${p.trialDays} gün ücretsiz dene` : 'Planı seç'}</a>
        </article>); })}
    </div>

    <h2 class="mt-16 text-center font-display text-3xl font-bold">Özellik karşılaştırması</h2>
    <div class="mt-6 overflow-x-auto rounded-2xl border border-line bg-surface">
      <table class="w-full min-w-[560px] text-left text-sm">
        <caption class="sr-only">Planlara göre özellik ve sınırlar</caption>
        <thead><tr class="border-b border-line"><th scope="col" class="p-3">Özellik</th>{products.map((p) => <th scope="col" class="p-3">{p.name}</th>)}</tr></thead>
        <tbody>{feats.map((k) => <tr class="border-b border-line last:border-0"><th scope="row" class="p-3 font-medium">{LABEL[k]}</th>{products.map((p) => <td class="p-3">{k === 'detailed_analysis' || k === 'score_estimate' ? (cell(p, k) === '—' ? '—' : '✓') : cell(p, k)}</td>)}</tr>)}</tbody>
      </table>
    </div>

    <h2 class="mt-16 text-center font-display text-3xl font-bold">Fiyat ve ödeme hakkında</h2>
    <div class="mx-auto mt-6 max-w-3xl space-y-3">
      {faq.map((a) => <a href={`/yardim/${a.slug}`} class="block rounded-xl border border-line bg-surface p-4 no-underline text-ink"><b>{a.title}</b><span class="mt-1 block text-sm text-ink-2">{a.excerpt}</span></a>)}
      <p class="text-center text-sm"><a href="/sss">Tüm sorular</a> · <a href="/iletisim">Bize yaz</a></p>
    </div>
  </section>
</Base>
